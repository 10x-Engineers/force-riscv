# Smoke list — this file selects which tests CI generates.
#
# Every uncommented line becomes one directory under smoke-output/ and one
# entry in the force-smoke-output artifact (and in a release bundle).
#
# Format (whitespace-separated). '#' starts a comment. Blank lines are ignored.
#
#   name  config  template  [extra friscv arguments...]
#
# Size is controlled with --options (comma-separated, no spaces):
#   instruction_count=N   how many instructions the template emits
#   loop_count=N          iterations for the loop template
#   vsew=E                vector element width field (0=e8 1=e16 2=e32 3=e64)
#   vlmul=M               vector register group (0=m1 1=m2 2=m4 3=m8 5=mf8 6=mf4 7=mf2)
#                         Fractional LMUL is only legal when SEW is narrower than ELEN.
#   vta=0|1               tail undisturbed (0) or agnostic (1)
#   vma=0|1               mask undisturbed (0) or agnostic (1)
#   vm=0|1                masked (0) or unmasked (1); applies to the int group
#   group=NAME            int, widen, muldiv, carry, fixed, float, mask, permute, reduce
#
# Paths are relative to the repository root.
# config/riscv-cva6.config is not listed: its XML paths are no longer in the tree.

# --- config/riscv_rv64.config : RV64, default virtual memory (Sv48) ---
rv64_add_sra     config/riscv_rv64.config  utils/smoke/test_force.py  --options instruction_count=128
rv64_integer     config/riscv_rv64.config  utils/smoke/riscv_force.py  --options instruction_count=64
rv64_random      config/riscv_rv64.config  examples/riscv/basic_random_01_force.py  --options instruction_count=512
rv64_loop        config/riscv_rv64.config  tests/riscv/loop/loop_basic_force.py  --options loop_count=128
rv64_vector_add  config/riscv_rv64.config  tests/riscv/vector/vector_simple_add_force.py  --options instruction_count=256
rv64_vector_moves_rtz  config/riscv_rv64.config  tests/riscv/vector/vector_moves_and_rtz_cvt_force.py  --options instruction_count=16
rv64_vector_ldst  config/riscv_rv64.config  tests/riscv/vector/vector_unit_stride_load_store_force.py  --options instruction_count=128

# Vector vtype configurations. Each line locks SEW and LMUL, then emits 256 integer vector ops.
# Template: utils/smoke/vector_config_force.py
rv64_vec_e8m1    config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=0,vlmul=0
rv64_vec_e16m1   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=1,vlmul=0
rv64_vec_e32m1   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=2,vlmul=0
rv64_vec_e64m1   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=3,vlmul=0
rv64_vec_e32m2   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=2,vlmul=1
rv64_vec_e16m4   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=1,vlmul=2
rv64_vec_e8m8    config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=256,vsew=0,vlmul=3
# Fractional LMUL (spec section 3.4). ELEN is 64, so mf* is legal only for SEW < 64.
rv64_vec_e32mf2  config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=2,vlmul=7
rv64_vec_e16mf2  config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=1,vlmul=7
rv64_vec_e16mf4  config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=1,vlmul=6
rv64_vec_e8mf2   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=0,vlmul=7
rv64_vec_e8mf4   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=0,vlmul=6
rv64_vec_e8mf8   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=0,vlmul=5
# Tail and mask policy (spec section 3.4.3), and an explicitly masked integer run.
rv64_vec_ta_ma   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=2,vlmul=0,vta=1,vma=1
rv64_vec_tu_mu   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=2,vlmul=0,vta=0,vma=0
rv64_vec_masked  config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=128,vsew=2,vlmul=0,vm=0
# Instruction groups from the V spec that the integer-only lines do not cover.
rv64_vec_widen    config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=widen
rv64_vec_muldiv   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=muldiv
rv64_vec_carry    config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=carry
