rv64_vec_float    config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=float
rv64_vec_mask     config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=mask
rv64_vec_permute  config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=permute
rv64_vec_reduce   config/riscv_rv64.config  utils/smoke/vector_config_force.py  --options instruction_count=64,vsew=2,vlmul=0,group=reduce
rv64_vec_strided  config/riscv_rv64.config  tests/riscv/vector/vector_strided_load_store_force.py  --options instruction_count=64
rv64_vec_indexed  config/riscv_rv64.config  tests/riscv/vector/vector_indexed_load_store_force.py  --options instruction_count=64
